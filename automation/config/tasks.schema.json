{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ailab/automation/tasks.schema.json",
  "title": "AI Lab Automation Tasks",
  "type": "object",
  "required": ["version", "tasks", "anythingllm", "archive", "logging"],
  "properties": {
    "version": { "type": "string" },
    "addendum": { "type": "string" },
    "timezone_default": { "type": "string" },
    "anythingllm": {
      "type": "object",
      "required": ["base_url", "keychain_service", "keychain_account"],
      "properties": {
        "base_url": { "type": "string" },
        "keychain_service": { "type": "string" },
        "keychain_account": { "type": "string" }
      }
    },
    "archive": {
      "type": "object",
      "required": ["root", "encryption", "keychain_service", "keychain_account"],
      "properties": {
        "root": { "type": "string" },
        "encryption": { "type": "string" },
        "keychain_service": { "type": "string" },
        "keychain_account": { "type": "string" }
      }
    },
    "logging": {
      "type": "object",
      "required": ["dir", "format"],
      "properties": {
        "dir": { "type": "string" },
        "format": { "type": "string", "enum": ["jsonl"] }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "enabled", "schedule", "workspace", "prompt_id", "output"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "enabled": { "type": "boolean" },
          "description": { "type": "string" },
          "schedule": {
            "type": "object",
            "required": ["hour", "minute", "timezone"],
            "properties": {
              "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
              "minute": { "type": "integer", "minimum": 0, "maximum": 59 },
              "timezone": { "type": "string" },
              "days_of_week": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
                }
              },
              "cron_comment": { "type": "string" }
            }
          },
          "workspace": {
            "type": "object",
            "required": ["slug", "local_only"],
            "properties": {
              "slug": { "type": "string" },
              "mode": { "type": "string" },
              "local_only": { "type": "boolean" },
              "model": { "type": "string" }
            }
          },
          "prompt_id": { "type": "string" },
          "output": {
            "type": "object",
            "required": ["title_prefix", "format"],
            "properties": {
              "title_prefix": { "type": "string" },
              "format": { "type": "string", "enum": ["markdown", "text"] }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
