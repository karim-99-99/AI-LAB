# groq (free) | openai (paid)
AI_PROVIDER=groq

# Optional override. llama-3.1-8b-instant was shut down (Aug 2026).
# Default if unset: openai/gpt-oss-20b
# AI_MODEL=openai/gpt-oss-20b
# Smarter: openai/gpt-oss-120b or qwen/qwen3.6-27b

# Phase 5 Step 5 — model routing (task → fast | strong)
# Fast: grammar, chat, short email, classify
AI_MODEL_FAST=openai/gpt-oss-20b
# Strong: RAG answers, extract JSON, resume, long drafts
AI_MODEL_STRONG=openai/gpt-oss-120b

# Groq free key: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# OpenAI (only if AI_PROVIDER=openai): https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here

# Practice auth — required for AI + automation routes when set
# Use the same value in curl / n8n as header: x-practice-key
PRACTICE_API_KEY=practice-dev-key

# Browser UI needs this to call protected routes (same value as above)
NEXT_PUBLIC_PRACTICE_API_KEY=practice-dev-key

# In-memory rate limit (requests per minute per key)
RATE_LIMIT_PER_MIN=10

# Real Gmail send on Approve (optional)
# 1) Enable 2-Step Verification on your Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords
# 3) Paste below (16 chars, no spaces needed)
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Phase 4 RAG embeddings — local (Groq has no embed model on your account)
# First ingest downloads the model once (~20–30MB)
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Phase 5 Step 2 — RAG answer cache
# Priority: Upstash → Docker Redis → in-memory
# Docker Redis (Step 4): docker compose -f n8n/docker-compose.yml up -d
REDIS_URL=redis://localhost:6379
# Optional Upstash instead of Docker Redis:
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxx
# Cache lifetime in seconds (default 600 = 10 minutes)
RAG_CACHE_TTL_SECONDS=600

# Deployment (Vercel)
# JSON stores default to <project>/data locally and /tmp on Vercel (ephemeral).
# DATA_DIR=/absolute/path
# Link shown on the /n8n page (default http://localhost:5678)
# NEXT_PUBLIC_N8N_URL=https://your-n8n.example.com

# Phase 7 Step 1 — guardrails
# GUARD_MAX_INPUT_CHARS=12000
# GUARD_MAX_OUTPUT_CHARS=8000
# GUARD_MAX_OUTPUT_TOKENS=1024
# Comma-separated blocked phrases (lowercase match)
# GUARD_BLOCKED_TOPICS=how to make a bomb,child sexual,credit card dump
